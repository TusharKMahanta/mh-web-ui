# ---------------------------------------------------------------------------
# Environment configuration template.
#
# Copy to `.env.local` for local overrides (git-ignored), or set these as real
# environment variables in staging/production (docker run -e ..., orchestrator,
# CI). Committed defaults for local dev live in `.env.development`.
#
# Every var here is read + validated once at server boot by
# `app/config/env.server.ts`. See `docs/CONFIGURATION.md`.
# ---------------------------------------------------------------------------

# Logical deployment environment: development | staging | production
# In staging/production, SESSION_SECRET (and API_BASE_URL when USE_MOCK_DATA=false)
# become REQUIRED — the server refuses to boot without them.
APP_ENV=development

# Port the production server (`npm start` / remix-serve) listens on.
PORT=3000

# --- Backend API (unused while USE_MOCK_DATA=true) --------------------------
# Absolute http(s) URL of the REST/GraphQL backend.
API_BASE_URL=
# Absolute http(s) URL of the store service (e.g. http://localhost:8085/mh-store-app).
STORE_API_BASE_URL=
# Absolute http(s) URL of the profile service (e.g. http://localhost:8085/mh-profile-app).
PROFILE_API_BASE_URL=
# Absolute http(s) URL of the auth service that issues access tokens after OTP
# login (e.g. http://localhost:8085/mh-auth-app).
AUTH_API_BASE_URL=
# Abort an API request after this many milliseconds.
API_TIMEOUT_MS=10000
# true  -> app/actions/*.server.ts serve in-memory mock data (default in dev)
# false -> service modules fetch against API_BASE_URL (which then becomes required)
USE_MOCK_DATA=true

# --- Observability --------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug

# --- Redis ---------------------------------------------------------------
# REQUIRED in staging/production. redis:// or rediss:// (TLS), e.g.
#   redis://:password@host:6379/0
# Dev default: redis://localhost:6379 (docker compose -f redis/docker-compose.yaml up -d)
REDIS_URL=redis://localhost:6379
# Prepended to every key so apps/environments can share one Redis instance.
REDIS_KEY_PREFIX=morhaat:
# Give up on establishing a connection after this many milliseconds.
REDIS_CONNECT_TIMEOUT_MS=5000

# --- Secrets (never sent to the browser) --------------------------------
# Used to sign cookies/sessions. Generate per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Login session lifetime in seconds (cookie maxAge; upper bound on the Redis
# TTL — a session never outlives its access token). Default 7 days.
SESSION_TTL_SECONDS=604800

# --- Public config (safe to expose; ends up on window.ENV) --------------
# Canonical public origin, used to build absolute URLs.
PUBLIC_SITE_URL=http://localhost:5173
# Feature flag: is checkout/commerce enabled in this environment.
PUBLIC_COMMERCE_ENABLED=true
