{
  "request": {
    "method": "POST",
    "urlPath": "/mh-auth-app/auth/token",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.identifier"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "auth/token.json"
  }
}
