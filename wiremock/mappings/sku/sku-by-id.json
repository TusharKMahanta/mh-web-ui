{
  "mappings": [
    {
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPath": "/mh-store-app/skus/sku_missing"
      },
      "response": {
        "status": 404,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "error": "SKU not found"
        }
      }
    },
    {
      "priority": 5,
      "request": {
        "method": "GET",
        "urlPathPattern": "/mh-store-app/skus/([A-Za-z0-9_-]+)"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "bodyFileName": "sku/sku-by-id.json"
      }
    }
  ]
}