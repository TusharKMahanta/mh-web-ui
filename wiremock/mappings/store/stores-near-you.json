{
  "request": {
    "method": "GET",
    "urlPath": "/mh-store-app/stores",
    "queryParameters": {
      "lat": {
        "matches": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "lng": {
        "matches": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "radius": {
        "matches": "[0-9]+(\\.[0-9]+)?$"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "store/stores-near-you.json"
  }
}
