{
  "request": {
    "method": "GET",
    "urlPathPattern": "/mh-store-app/stores",
    "queryParameters": {
      "ids": {
        "matches": "[A-Za-z0-9_-]+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "store/stores-by-ids.json"
  }
}
