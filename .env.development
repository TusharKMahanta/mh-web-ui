# Committed dev defaults. Loaded automatically by the Remix Vite plugin during
# `npm run dev` (Vite mode = "development"). NEVER put real secrets here — it is
# tracked by git. Put local-only overrides in `.env.local` (git-ignored).

APP_ENV=development
PORT=3000

API_BASE_URL=
API_TIMEOUT_MS=10000
USE_MOCK_DATA=true

LOG_LEVEL=debug

# Placeholder only — fine for dev, rejected in staging/production.
SESSION_SECRET=dev-insecure-session-secret

PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_COMMERCE_ENABLED=true
